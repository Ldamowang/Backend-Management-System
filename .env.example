# ===========================================
# Admin Management System - 环境变量配置模板
# ===========================================
# 使用方法: 复制此文件为 .env 并修改对应值
#   cp .env.example .env
# ===========================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=<your_mysql_root_password>
MYSQL_DATABASE=admin_db
MYSQL_PORT=3306

# ---------- Redis ----------
REDIS_PASSWORD=<your_redis_password>
REDIS_PORT=6379

# ---------- Backend (Spring Boot) ----------
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/admin_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=<your_db_username>
SPRING_DATASOURCE_PASSWORD=<your_db_password>
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# ---------- JWT ----------
# 生产环境请使用: openssl rand -base64 64 生成随机密钥 (至少 256 位)
JWT_SECRET=<your_jwt_secret_base64_encoded>
# Access Token 过期时间 (毫秒), 默认 30 分钟
JWT_ACCESS_TOKEN_EXPIRATION=1800000
# Refresh Token 过期时间 (毫秒), 默认 7 天
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ---------- CORS ----------
# 允许的前端来源域名，多个用逗号分隔
CORS_ALLOWED_ORIGINS=https://admin.example.com

# ---------- Nginx ----------
NGINX_PORT=80

# ---------- Logging ----------
LOG_LEVEL=info
